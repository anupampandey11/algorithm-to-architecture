# ==============================
# Operating System Files
# ==============================

# Ignore everything
*

# Allow directories
!*/

# Allow C++ source and header files
!*.[cC][pP][pP]
!*.c
!*.h
!*.hpp

# Allow HTML visualizers and markdown documentation
!*.html
!*.md

# Allow .gitignore itself
!.gitignore

# Ignore temporary runner files
tempCodeRunnerFile*
tempCodeRunnerFile.cpp

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini
ehthumbs.db

# Linux / Temporary
*~


# ==============================
# C++ Executable / Binary Files
# ==============================

*.exe
*.out
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.dylib


# ==============================
# Build Directories
# ==============================

build/
bin/
out/
Debug/
Release/


# ==============================
# IDE / Editor Files
# ==============================

.vscode/
.idea/

*.swp
*.swo


# ==============================
# CMake Generated Files
# ==============================

CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json


# ==============================
# Debug / Temporary Files
# ==============================

*.log
*.tmp
*.temp


# ==============================
# Core Dumps
# ==============================

core
core.*
